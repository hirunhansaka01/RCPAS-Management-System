# File-based SQLite database; no MySQL server required. Relative to the project root.
# Used only when no TURSO_DATABASE_URL is set (local development).
DATABASE_URL=./data/rcpas.sqlite

# --- Durable hosting (Vercel / serverless) ---------------------------------
# Vercel's filesystem is ephemeral, so a hosted database is required for data to
# survive cold starts and redeploys. Set both to use Turso; leave them blank for
# local SQLite. Obtain with:  turso db create rcpas  &&  turso db tokens create rcpas
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Origin the app is served from. Locally that is the dev server; in production
# it is your deployment URL. It is the value checked on every CORS preflight and
# the value the session cookies are scoped to.
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- Admin provisioning (optional) -----------------------------------------
# On a fresh database (e.g. a brand-new Turso DB) these create the first System
# Administrator account at cold start. They are required the first time you point
# at an empty database; after that an existing password is never overwritten.
SETUP_ADMIN_OPEN_ID=
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_PASSWORD=
SETUP_ADMIN_NAME=

# --- Test suite credentials (optional) -------------------------------------
# No password ships with this repository. To run the end-to-end suites against
# your own database, choose your own values here and create matching accounts:
#   SETUP_ADMIN_* above  -> sign in as admin@rcpas.local
#                            (set SETUP_ADMIN_PASSWORD to TEST_ADMIN_PASSWORD)
#   pnpm db:setup-test-accounts -> the other three accounts
# Read by tests/creds.mjs and tests/make-test-accounts.ts.
TEST_ADMIN_PASSWORD=
TEST_PRESIDENT_PASSWORD=
TEST_CHIEF_PASSWORD=
TEST_ORGANIZER_PASSWORD=
