{
  "name": "rcpas-portal",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/server/migrate.ts",
    "db:seed": "tsx src/server/seed.ts",
    "db:setup-admin": "tsx src/server/setup-admin.ts",
    "db:reset-data": "node tests/reset-data.mjs",
    "db:setup-test-accounts": "tsx tests/make-test-accounts.ts",
    "db:remove-test-accounts": "tsx tests/remove-test-accounts.ts",
    "db:report": "tsx tests/report-final-state.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/make-test-accounts.ts && node tests/reset-data.mjs && node tests/stage1-smoke.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
